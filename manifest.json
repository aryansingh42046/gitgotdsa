{
  "manifest_version": 3,
  "name": "GitGotDSA",
  "version": "2.0.0",
  "description": "Automatically push your accepted LeetCode, GeeksforGeeks and Codeforces solutions to GitHub.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://practice.geeksforgeeks.org/*",
    "https://codeforces.com/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*",
        "https://practice.geeksforgeeks.org/problems/*"
      ],
      "js": ["gfg.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*",
        "https://practice.geeksforgeeks.org/problems/*"
      ],
      "js": ["gfg-content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://codeforces.com/contest/*/my",
        "https://codeforces.com/gym/*/my",
        "https://codeforces.com/problemset/status*",
        "https://codeforces.com/submissions/*"
      ],
      "js": ["codeforces.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
